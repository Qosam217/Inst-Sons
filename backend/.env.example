# ==========================================
# Inst Sons Backend - Environment Variables
# ==========================================

# Port untuk menjalankan server backend (default: 5000)
PORT=5000

# Environment: development | production | test (default: development)
NODE_ENV=development

# URL origin yang diizinkan untuk CORS (pisahkan dengan koma jika lebih dari satu, default: *)
# Contoh: http://localhost:3000 atau https://domain-frontend-anda.com
CORS_ORIGIN=http://localhost:3000

# Rahasia JWT untuk menandatangani & memverifikasi token autentikasi (WAJIB diganti di production)
JWT_SECRET=your-secure-jwt-secret-key-change-this-in-production

# ==========================================
# Konfigurasi Database PostgreSQL
# ==========================================
# Opsi 1: Connection string lengkap (Prioritas utama jika diisi, cocok untuk Supabase/Neon/Fly Postgres)
# Contoh: postgresql://postgres:password@localhost:5432/inst_sons
DATABASE_URL=

# Opsi 2: Kredensial terpisah (Digunakan jika DATABASE_URL kosong, cocok untuk local development)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=inst_sons

# Batas maksimal koneksi pool PostgreSQL (default: 4, optimal untuk VM low-memory/Fly.io Free Tier)
DB_POOL_MAX=4
